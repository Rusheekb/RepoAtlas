    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
