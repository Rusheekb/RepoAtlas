{
  "name": "repo-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "RepoAtlas — see how any GitHub project works, explained visually in plain English.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
